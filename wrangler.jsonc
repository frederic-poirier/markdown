{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "texte",
	"compatibility_date": "2025-02-12",
	"pages_build_output_dir": "dist",
	"r2_buckets": [
		{
			"bucket_name": "texte-r2",
			"binding": "texte_r2",
		}
	],
	"d1_databases": [
		{
			"binding": "texte_d1",
			"database_name": "texte-d1",
			"database_id": "e9b50ed2-46fe-4dc0-8994-6af52910619c",
		}
	]
}
